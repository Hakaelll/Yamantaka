# Capture hashes describe exact bytes; preserve sidecar and manifest line endings.
docs/screenshots/rust-*/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
docs/validation/*.json -text whitespace=trailing-space,space-before-tab,cr-at-eol

# Preserve verified upstream source and local patch hashes across checkouts.
third_party/pdfium-render/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
